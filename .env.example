DATA_DIR_PATH="data/"

#
# Machine name 
#
NODE_NAME="main"

#
# Cache
#
CACHE_MAX_SIZE_IN_GB=100

#
# SQLite database is stored at DATA_DIR_PATH/database/database.db
#

#
# List of available newspaper corpora (comma-separated)
#
CORPORA="BPL"

#
# List of S3-compatible buckets containing scans for each corpus. 
#
#CORPUSNAME_S3_BUCKET_NAME=""
#CORPUSNAME_S3_ENDPOINT=""
#CORPUSNAME_S3_REGION=""
#CORPUSNAME_S3_ACCESS_KEY_ID=""
#CORPUSNAME_S3_SECRET_ACCESS_KEY="" 

#
# Output bucket
#
OUTPUT_S3_BUCKET_NAME=""
OUTPUT_S3_ENDPOINT=""
OUTPUT_S3_REGION=""
OUTPUT_S3_ACCESS_KEY_ID=""
OUTPUT_S3_SECRET_ACCESS_KEY=""

#
# Release bucket
#
RELEASE_S3_BUCKET_NAME=""
RELEASE_S3_ENDPOINT=""
RELEASE_S3_REGION="auto"
RELEASE_S3_ACCESS_KEY_ID=""
RELEASE_S3_SECRET_ACCESS_KEY=""

#
# Release dataset
#
RELEASE_HF_DATASET=""

#
# Compute constraints
#
#CUDA_VISIBLE_DEVICES="0,1,2,3"
#CPUS_LIMIT=128
MAX_S3_CONCURRENCY=32 # How many operations can we run in parallel against S3 (compatible) storage
#OMP_NUM_THREADS=1 # Prevent PyTorch from starting its own process/thread pool
PIPELINE_BATCH_TIMEOUT_SECONDS=14400 # Allows for unlocking stale batch locks
#STEP01_CACHE_MAX_CONSECUTIVE_FAILURES=5 # Consecutive S3 download failures before circuit breaker trips
#STEP01_CACHE_FAILURE_PAUSE_MINUTES=10 # Minutes to pause before restarting step01_cache
# More in const/__init__.py

#
# HuggingFace
#
HF_TOKEN=""
#HF_HOME="/path/to/hf-cache"

#
# Tesseract 
# 
OCR_TESSDATA_DIR_PATH="/usr/local/share/tessdata"


#
# Telemetry 
#
VLLM_NO_USAGE_STATS=1
DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
HF_HUB_DISABLE_TELEMETRY=1

# 
# Backups: remote and bucket name for rclone
#
BACKUP_RCLONE_REMOTE=""
BACKUP_RCLONE_BUCKET=""